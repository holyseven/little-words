# 直接从网页调用 Azure（适合本项目的家庭用量测试；密钥会进入网页包）。
VITE_AZURE_SPEECH_KEY=
VITE_AZURE_SPEECH_REGION=eastus
# 可选：自定义 Azure Speech endpoint。
VITE_AZURE_SPEECH_ENDPOINT=

# 没有上面两项时，前端才会请求本地 /api/pronunciation 代理。
VITE_PRONUNCIATION_PROXY_URL=

# 本地代理的服务端配置（只有不使用 VITE_* 直连时才需要）。
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_ENDPOINT=
